  <ReportParameters>
    <ReportParameter Name="AnioInicial">
      <DataType>Integer</DataType>
      <DefaultValue>
        <Values>
          <Value>=Year(DateAdd("m", -13, Today()))</Value>
        </Values>
      </DefaultValue>
      <Prompt>Fecha Inicio: Año:</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>dsAnios</DataSetName>
          <ValueField>ID_Anios_</ValueField>
          <LabelField>ID_Anios_</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
    <ReportParameter Name="MesInicial">
      <DataType>Integer</DataType>
      <DefaultValue>
        <Values>
          <Value>=Month(DateAdd("m", -13, Today()))</Value>
        </Values>
      </DefaultValue>
