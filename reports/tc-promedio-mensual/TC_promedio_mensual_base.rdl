  <DataSets>
    <DataSet Name="dsAnios">
      <Query>
        <DataSourceName>BI_DatosPrioritarios</DataSourceName>
        <CommandText>
EVALUATE
SELECTCOLUMNS(
    DISTINCT('Precios_ExPLanta_TM1'[Años]),
    "Anios", VALUE('Precios_ExPLanta_TM1'[Años])
)
ORDER BY [Anios] DESC
        </CommandText>
      </Query>
      <Fields>
        <Field Name="ID_Anios_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Anios]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsMeses">
      <Query>
        <DataSourceName>BI_DatosPrioritarios</DataSourceName>
        <CommandText>
EVALUATE
DATATABLE(
    "Mes", INTEGER,
    "Periodo_Mensual", STRING,
    {
        {1, "Ene"},
        {2, "Feb"},
        {3, "Mar"},
        {4, "Abr"},
        {5, "May"},
        {6, "Jun"},
        {7, "Jul"},
        {8, "Ago"},
        {9, "Sep"},
        {10, "Oct"},
        {11, "Nov"},
        {12, "Dic"}
    }
)
        </CommandText>
      </Query>
      <Fields>
        <Field Name="ID_Mes_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Mes]</DataField>
        </Field>
        <Field Name="ID_Periodo_Mensual_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Periodo_Mensual]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsDescripcion">
      <Query>
        <DataSourceName>BI_DatosPrioritarios</DataSourceName>
        <CommandText>
EVALUATE
ROW(
    "Descripcion",
    "Promedio mensual del tipo de cambio dólares estadounidense vs pesos uruguayos promedio. Fuente SAP"
)
        </CommandText>
      </Query>
      <Fields>
        <Field Name="ID_Descripcion_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Descripcion]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsTCPromedio">
      <Query>
        <DataSourceName>BI_DatosPrioritarios</DataSourceName>
        <CommandText>
EVALUATE
SELECTCOLUMNS(
    FILTER(
        'Precios_ExPLanta_TM1',
        'Precios_ExPLanta_TM1'[Unidades] = "N/A" &amp;&amp;
        'Precios_ExPLanta_TM1'[Productos_ExPlanta] = "N/A" &amp;&amp;
        'Precios_ExPLanta_TM1'[Mercados] = "N/A" &amp;&amp;
        'Precios_ExPLanta_TM1'[Periodo_Diario] = "Valor Mensual" &amp;&amp;
        'Precios_ExPLanta_TM1'[Medidas_ExPlanta] = "Cotización Promedio"
    ),
    "Año", VALUE('Precios_ExPLanta_TM1'[Años]),
    "Mes",
    SWITCH(
        'Precios_ExPLanta_TM1'[Periodo_Mensual],
        "Ene", 1,
        "Feb", 2,
        "Mar", 3,
        "Abr", 4,
        "May", 5,
        "Jun", 6,
        "Jul", 7,
        "Ago", 8,
        "Sep", 9,
        "Oct", 10,
        "Nov", 11,
        "Dic", 12,
        BLANK()
    ),
    "DescripcionMiembro", 'Precios_ExPLanta_TM1'[Periodo_Mensual],
    "CotizacionPromedio", 'Precios_ExPLanta_TM1'[Valor]
)
ORDER BY [Año], [Mes]
        </CommandText>
      </Query>
      <Fields>
        <Field Name="Precios_ExPLanta_TM1_Años_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Precios_ExPLanta_TM1[Años]</DataField>
        </Field>
        <Field Name="Precios_ExPLanta_TM1_Periodo_Mensual_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Precios_ExPLanta_TM1[Periodo_Mensual]</DataField>
        </Field>
        <Field Name="ID_Año_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Año]</DataField>
        </Field>
        <Field Name="ID_Mes_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Mes]</DataField>
        </Field>
        <Field Name="ID_DescripcionMiembro_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[DescripcionMiembro]</DataField>
        </Field>
        <Field Name="ID_CotizacionPromedio_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[CotizacionPromedio]</DataField>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=DateSerial(CInt(Fields!ID_Año_.Value), CInt(Fields!ID_Mes_.Value), 1)</FilterExpression>
          <Operator>GreaterThanOrEqual</Operator>
          <FilterValues>
            <FilterValue>=DateSerial(Parameters!AnioInicial.Value, Parameters!MesInicial.Value, 1)</FilterValue>
          </FilterValues>
        </Filter>
        <Filter>
          <FilterExpression>=DateSerial(CInt(Fields!ID_Año_.Value), CInt(Fields!ID_Mes_.Value), 1)</FilterExpression>
          <Operator>LessThanOrEqual</Operator>
          <FilterValues>
            <FilterValue>=DateAdd("d", -1, DateAdd("m", 1, DateSerial(Parameters!AnioFinal.Value, Parameters!MesFinal.Value, 1)))</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
  </DataSets>
