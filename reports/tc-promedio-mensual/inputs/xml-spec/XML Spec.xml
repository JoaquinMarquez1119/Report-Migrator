	function setFecha() {

		var FechaDesde = new Date(new Date().setDate(new Date().getDate()-365));
		FechaDesde .setMonth(FechaDesde .getMonth() - 1);
		var yearFrom = FechaDesde.getFullYear();
		var monthFrom = FechaDesde.getMonth();
                                          
    		switch (monthFrom) {
    			case 0:
    				monthFrom= 1;
    				break;
    			case 1:
    				monthFrom= 2;
    				break;
    			case 2:
    				monthFrom= 3;
    				break;
    			case 3:
    				monthFrom= 4;
    				break;
    			case 4:
    				monthFrom= 5;
    				break;
    			case 5:
    				monthFrom= 6;
    				break;
    			case 6:
    				monthFrom= 7;
    				break;
    			case 7:
    				monthFrom= 8;
    				break;
    			case 8:
    				monthFrom= 9;
    				break;
    			case 9:
    				monthFrom= 10;
    				break;
    			case 10:
    				monthFrom= 11;
    				break;
    			case 11:
    				monthFrom= 12;
    				break;
      			default:
    				monthFrom= 0;
  		}

		var FechaActual = new Date();
		FechaActual.setMonth(FechaActual.getMonth() - 1);
		var yearTo = FechaActual.getFullYear();
		var monthTo = FechaActual.getMonth();
		
		switch (monthTo) {
    			case 0:
    				monthTo= 1;
    				break;
    			case 1:
    				monthTo= 2;
    				break;
    			case 2:
    				monthTo= 3;
    				break;
    			case 3:
    				monthTo= 4;
    				break;
    			case 4:
    				monthTo= 5;
    				break;
    			case 5:
    				monthTo= 6;
    				break;
    			case 6:
    				monthTo= 7;
    				break;
    			case 7:
    				monthTo= 8;
    				break;
    			case 8:
    				monthTo= 9;
    				break;
    			case 9:
    				monthTo= 10;
    				break;
    			case 10:
    				monthTo= 11;
    				break;
    			case 11:
    				monthTo= 12;
    				break;
      			default:
    				monthTo= 0;
    		}

		var parametros = [yearFrom, yearTo, monthFrom, monthTo]; 

		var j = 0;
		var ary = [];
		document.getElementById("bloque").style.display="block";
  		var inputs = document.getElementsByTagName("input"); 
  	  		for (var i=0; i&lt;inputs.length; i++) {      
			if (inputs[i].type.toLowerCase() === "text") {
				inputs[i].value=parametros[j];
				j++;
    			}
  		}

		document.getElementById("bloque").style.display="none";
		setTimeout("promptear()", 500);
					
	}

