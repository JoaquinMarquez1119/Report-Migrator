rs!pUnidad.Value) = &quot;USD/m3&quot; And Not IsNothing(Fields!PEPUSD.Value) And Fields!PEPUSD.Value &lt;&gt; 0) Or (Code.NormalizeUnit(Parameters!pUnidad.Value) &lt;&gt; &quot;USD/m3&quot; And Not IsNothing(Fields!PEP.Value) And Fields!PEP.Value &lt;&gt; 0), 1, Nothing), &quot;dsDetalle&quot;) = 0</Hidden></Visibility></TablixMember><TablixMember><Visibility><Hidden>=Not Code.IsColumnAllowed(&quot;Detail&quot;, Parameters!pProducto.Value, Parameters!pAnio.Value, Parameters!pUnidad.Value, &quot;Factor&quot;) Or Count(IIF((Code.NormalizeUnit(Parameters!pUnidad.Value) = &quot;USD/m3&quot; And Not IsNothing(Fields!FactorAjusteUSD.Value) And Fields!FactorAjusteUSD.Value &lt;&gt; 0) Or (Code.NormalizeUnit(Parameters!pUnidad.Value) &lt;&gt; &quot;USD/m3&quot; And Not IsNothing(Fields!FactorAjuste.Value) And Fields!FactorAjuste.Value &lt;&gt; 0), 1, Nothing), &quot;dsDetalle&quot;) = 0</Hidden></Visibility></TablixMember><TablixMember><Visibility><Hidden>=Not Code.IsColumnAllowed(&quot;Detail&quot;, Parameters!pProducto.Value, Parameters!pAnio.Value, Parameters!pUnidad.Value, &quot;Ursea&quot;) Or Count(IIF((Code.NormalizeUnit(Parameters!pUnidad.Value) = &quot;USD/m3&quot; And Not IsNothing(Fields!PEPCalcUrseaUSD.Value) And Fields!PEPCalcUrseaUSD.Value &lt;&gt; 0) Or (Code.NormalizeUnit(Parameters!pUnidad.Value) &lt;&gt; &quot;USD/m3&quot; And Not IsNothing(Fields!PEPCalcUrsea.Value) And Fields!PEPCalcUrsea.Value &lt;&gt; 0), 1, Nothing), &quot;dsDetalle&quot;) = 0</Hidden></Visibility></TablixMember><TablixMember><Visibility><Hidden>=Not Code.IsColumnAllowed(&quot;Detail&quot;, Parameters!pProducto.Value, Parameters!pAnio.Value, Parameters!pUnidad.Value, &quot;MontoDiferencial&quot;) Or Count(IIF((Code.NormalizeUnit(Parameters!pUnidad.Value) = &quot;USD/m3&quot; And Not IsNothing(Fields!MontoDiferencialZonasDUSD.Value) And Fields!MontoDiferencialZonasDUSD.Value &lt;&gt; 0) Or (Code.NormalizeUnit(Parameters!pUnidad.Value) &lt;&gt; &quot;USD/m3&quot; And Not IsNothing(Fiel