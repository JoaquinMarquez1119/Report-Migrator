                        <TablixCell>
                          <CellContents>
                            <Textbox Name="txtUyuProducto">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Switch(Fields!Producto.Value = "Asfalto AC-20", "Asfalto AC-30", Fields!Producto.Value = "Super 95 Sp", "Gasolina Super 95", Fields!Producto.Value = "Premium 97 Sp", "Gasolina Premium 97", Fields!Producto.Value = "Gasoil Comun", "Gasoil 50-S", Fields!Producto.Value = "Gasoil Especial", "Gasoil 10-S", Fields!Producto.Value = "Propano", "Propano Industrial", True, Fields!Producto.Value)</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                        <TextDecoration>Underline</TextDecoration>
                                        <Color>Blue</Color>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                              </Paragraphs>
                              <ActionInfo>
                                <Actions>
                                  <Action>
                                    <Drillthrough>
                                      <ReportName>Precios Unitarios Ex Planta - detalle</ReportName>
                                      <Parameters>
                                        <Parameter Name="pAnio">
                                          <Value>=Parameters!pAnio.Value</Value>
                                        </Parameter>
                                        <Parameter Name="pUnidad">
                                      <Value>=IIF(Parameters!pUnidad.Value = "USD/m3", "USD/m3", "$/lt ó $/kg según corresponda")</Value>
                                        </Parameter>
                                        <Parameter Name="pProducto">
                                          <Value>=Switch(Fields!Producto.Value = "Asfalto AC-20", "Asfalto AC-30", Fields!Producto.Value = "Super 95 Sp", "Gasolina Super 95", Fields!Producto.Value = "Premium 97 Sp", "Gasolina Premium 97", Fields!Producto.Value = "Gasoil Comun", "Gasoil 50-S", Fields!Producto.Value = "Gasoil Especial", "Gasoil 10-S", Fields!Producto.Value = "Propano", "Propano Industrial", True, Fields!Producto.Value)</Value>
                                        </Parameter>
                                        <Parameter Name="pVista">
                                          <Value>Resumen</Value>
                                        </Parameter>
                                      </Parameters>
                                    </Drillthrough>
                                  </Action>
                                </Actions>
                              </ActionInfo>
                              <Style>
                                <Border>
                                  <Color>Gray</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>#dcdcdc</BackgroundColor>
                                <PaddingLeft>4pt</PaddingLeft>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="txtUyuUnidad">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=IIF(Fields!Producto.Value = "Propano" Or Fields!Producto.Value = "Propano Industrial", "$/kg", Fields!Unidad.Value)</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
                                  <Color>Gray</Color>
                                  <Style>Solid</Style>
                                </Border>
                                <BackgroundColor>#dcdcdc</BackgroundColor>
                              </Style>
                            </Textbox>
                          </CellContents>
                        </TablixCell>
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="txtUyuM01">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=IIF(IsNothing(Max(IIF(Fields!MesNumero.Value = 1, Fields!PrecioExPlantaUYU.Value, Nothing), "grpUYUDetail")) OR Max(IIF(Fields!MesNumero.Value = 1, Fields!PrecioExPlantaUYU.Value, Nothing), "grpUYUDetail") = 0, "-", Format(CDec(Max(IIF(Fields!MesNumero.Value = 1, Fields!PrecioExPlantaUYU.Value, Nothing), "grpUYUDetail")), "N2"))</Value>
                                      <Style>
                                        <FontSize>8pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Right</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Style>
                                <Border>
