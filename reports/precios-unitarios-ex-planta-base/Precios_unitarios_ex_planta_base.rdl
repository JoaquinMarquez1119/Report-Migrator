                              </Paragraphs>
                              <ActionInfo>
                                <Actions>
                                  <Action>
                                    <Drillthrough>
                                      <ReportName>Precios Unitarios Ex Planta - detalle</ReportName>
                                      <Parameters>
                                        <Parameter Name="pAnio">
                                          <Value>=Parameters!pAnio.Value</Value>
                                        </Parameter>
                                        <Parameter Name="pUnidad">
                                      <Value>=IIF(Parameters!pUnidad.Value = "USD/m3", "USD/m3", "$/lt ó $/kg según corresponda")</Value>
                                        </Parameter>
                                        <Parameter Name="pProducto">
                                          <Value>=Switch(Fields!Producto.Value = "Asfalto AC-20", "Asfalto AC-30", Fields!Producto.Value = "Super 95 Sp", "Gasolina Super 95", Fields!Producto.Value = "Premium 97 Sp", "Gasolina Premium 97", Fields!Producto.Value = "Gasoil Comun", "Gasoil 50-S", Fields!Producto.Value = "Gasoil Especial", "Gasoil 10-S", Fields!Producto.Value = "Propano", "Propano Industrial", True, Fields!Producto.Value)</Value>
                                        </Parameter>
                                        <Parameter Name="pVista">
                                          <Value>Resumen</Value>
                                        </Parameter>
                                      </Parameters>
                                    </Drillthrough>
                                  </Action>
                                </Actions>
                              </ActionInfo>
                              <Style>
