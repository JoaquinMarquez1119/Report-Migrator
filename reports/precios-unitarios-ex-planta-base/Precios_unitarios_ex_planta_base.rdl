  </am:AuthoringMetadata>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="BI_DatosPrioritarios">
      <rd:SecurityType>None</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://api.powerbi.com/;Identity Provider="https://login.microsoftonline.com/organizations, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-03343eef-bfa0-4417-a085-ed40ba738766;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>679e3d27-1ec6-4be5-a37f-ab84af3deba8</rd:DataSourceID>
      <rd:PowerBIWorkspaceName>BI</rd:PowerBIWorkspaceName>
      <rd:PowerBIDatasetName>Datos Prioritarios</rd:PowerBIDatasetName>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsAnio">
      <Query>
        <DataSourceName>BI_DatosPrioritarios</DataSourceName>
        <CommandText>
EVALUATE
VAR __Anios =
    ADDCOLUMNS(
        DISTINCT('Precios_ExPLanta_2_TM1'[Años]),
        "AnioNum", IFERROR(VALUE('Precios_ExPLanta_2_TM1'[Años]), BLANK())
    )
RETURN
SELECTCOLUMNS(
    FILTER(__Anios, NOT ISBLANK([AnioNum]) &amp;&amp; [AnioNum] &lt;= YEAR(TODAY())),
    "Anio", [AnioNum]
)
ORDER BY [Anio] DESC
        </CommandText>
      </Query>
      <Fields>
        <Field Name="Anio">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>[Anio]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsDescripcion">
      <Query>
        <DataSourceName>BI_DatosPrioritarios</DataSourceName>
        <CommandText>
EVALUATE
ROW(
    "Descripcion",
    "Precios Ex planta promedio mensuales en USD/m3 y $/lt (o $/kg. según corresponda), para los productos mercado interno. Supergas, propano, butano desodorizado y asfaltos se expresan en $/kg. Desde Enero 2022 todos los productos se convierten a USD/m3 con el T.C. promedio del mes (o promedio del período transcurrido del mes si no es al cierre del mismo). Para el período Julio-Diciembre 2021, todos los productos excepto Supergas, propano y asfaltos se convirtieron a USD con el T.C. promedio del período que tomó URSEA para el cálculo de los PPI."
        &amp; UNICHAR(10) &amp;
    "Los Precios Ex planta surgen de deducirle a los Precios de venta al Público, los costos unitarios de flete, tasas, márgenes, bonificaciones e impuestos que correspondieran, como se observa al ingresar a cada producto."
        &amp; UNICHAR(10) &amp;
    "La Tasa inflamable fue derogada a partir del 13 de agosto de 2023."
        &amp; UNICHAR(10) &amp;
    "A partir de Julio de 2025, cambió la metodología de fijación de los PPI. El Poder Ejecutivo actualiza mensualmente el PEP y aprueba cada dos meses el PVP, tomando como referencia para el cálculo el promedio de los dos últimos valores de PPI publicados por la URSEA. En virtud de ello, se agregan en el resumen y detalle de los productos a los que aplica esta metodología (Gasolinas, Gasoil, Fueloil medio y pesado, Supergás y Propano) dos nuevos componentes ""PPI n-1 Periodo URSEA"" y ""PPI n-2 Periodo URSEA""."
        &amp; UNICHAR(10) &amp;
    "Para cada mes, para los productos expresados en $/kg se empleará en el cálculo la densidad real promedio del mes anterior."
        &amp; UNICHAR(10) &amp;
    "Para los productos cuyas paridades de importación publica URSEA, la diferencia entre los Precios ex planta calculados de esta manera (partiendo de los precios de venta al público aprobados por PE para cada mes) y el Precio ex planta calculado por URSEA, es el Factor de Ajuste."
)
        </CommandText>
      </Query>
      <Fields>
        <Field Name="Descripcion">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Descripcion]</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsTabla">
      <Query>
        <DataSourceName>BI_DatosPrioritarios</DataSourceName>
        <CommandText>
EVALUATE
VAR __CurDate = TODAY()
VAR __CurYear = YEAR(__CurDate)
VAR __CurMonth = MONTH(__CurDate)
VAR __CurDay = DAY(__CurDate)

VAR __BranchASeed1 =
    ADDCOLUMNS(
        SUMMARIZECOLUMNS(
            'Precios_ExPLanta_2_TM1'[Años],
            'Precios_ExPLanta_2_TM1'[Periodo_Mensual],
            'Precios_ExPLanta_2_TM1'[Productos_ExPlanta],
            FILTER(
                ALL('Precios_ExPLanta_2_TM1'),
                'Precios_ExPLanta_2_TM1'[Años] &lt;&gt; "Año Base" &amp;&amp;
                'Precios_ExPLanta_2_TM1'[Periodo_Mensual] &lt;&gt; "Base" &amp;&amp;
                LEFT('Precios_ExPLanta_2_TM1'[Productos_ExPlanta], 4) &lt;&gt; "RPMS" &amp;&amp;
                'Precios_ExPLanta_2_TM1'[Productos_ExPlanta] IN {
                    "Asfalto 150/200", "Asfalto AC-20", "Asfalto MC1", "Asfalto RC2",
                    "Propano Industrial", "Propano Redes", "Supergas", "Supergas A Granel"
                }
            ),
            "PrecioUSDRaw", CALCULATE(SUM('Precios_ExPLanta_2_TM1'[Valor]), 'Precios_ExPLanta_2_TM1'[Medidas_ExPlanta] = "Precio Ex Planta"),
            "DensidadRaw", CALCULATE(SUM('Precios_ExPLanta_2_TM1'[Valor]), 'Precios_ExPLanta_2_TM1'[Medidas_ExPlanta] = "Densidad"),
            "CotizacionRaw", CALCULATE(SUM('Precios_ExPLanta_2_TM1'[Valor]), 'Precios_ExPLanta_2_TM1'[Medidas_ExPlanta] = "Cotización", 'Precios_ExPLanta_2_TM1'[Mercados] = "Interno", 'Precios_ExPLanta_2_TM1'[Unidades] = "N/A")
        ),
        "pAnio", VALUE('Precios_ExPLanta_2_TM1'[Años]),
        "MesNumero", SWITCH('Precios_ExPLanta_2_TM1'[Periodo_Mensual], "Ene", 1, "Feb", 2, "Mar", 3, "Abr", 4, "May", 5, "Jun", 6, "Jul", 7, "Ago", 8, "Sep", 9, "Oct", 10, "Nov", 11, "Dic", 12, BLANK())
    )
VAR __BranchASeed =
    ADDCOLUMNS(
        __BranchASeed1,
        "AnioMes", [pAnio] * 100 + [MesNumero],
        "Dia", IF([pAnio] = __CurYear &amp;&amp; [MesNumero] = __CurMonth, FORMAT(__CurDay, "0") &amp; "-" &amp; 'Precios_ExPLanta_2_TM1'[Periodo_Mensual], FORMAT(DAY(EOMONTH(DATE([pAnio], [MesNumero], 1), 0)), "0") &amp; "-" &amp; 'Precios_ExPLanta_2_TM1'[Periodo_Mensual])
    )
VAR __BranchA =
    SELECTCOLUMNS(
        FILTER(
            __BranchASeed,
            NOT ('Precios_ExPLanta_2_TM1'[Productos_ExPlanta] IN { "Propano Industrial", "Propano Redes", "Supergas", "Supergas A Granel" } &amp;&amp; [AnioMes] &gt; 202306)
        ),
        "pAnio", [pAnio],
        "MesNumero", [MesNumero],
        "Dia", [Dia],
        "Producto", 'Precios_ExPLanta_2_TM1'[Productos_ExPlanta],
        "PrecioExPlantaUSD", [PrecioUSDRaw],
        "PrecioExPlantaUYU", IF('Precios_ExPLanta_2_TM1'[Productos_ExPlanta] IN { "Asfalto 150/200", "Asfalto AC-20" }, DIVIDE([PrecioUSDRaw] * [CotizacionRaw], 1000), DIVIDE([PrecioUSDRaw] * DIVIDE([CotizacionRaw], [DensidadRaw], BLANK()), 1000)),
        "CotizacionPromedio", [CotizacionRaw]
    )

VAR __BranchBSeed1 =
    ADDCOLUMNS(
        SUMMARIZECOLUMNS(
            'Precios_ExPLanta_2_TM1'[Años],
            'Precios_ExPLanta_2_TM1'[Periodo_Mensual],
            'Precios_ExPLanta_2_TM1'[Productos_ExPlanta],
            FILTER(
                ALL('Precios_ExPLanta_2_TM1'),
                'Precios_ExPLanta_2_TM1'[Años] &lt;&gt; "Año Base" &amp;&amp;
                'Precios_ExPLanta_2_TM1'[Periodo_Mensual] &lt;&gt; "Base" &amp;&amp;
                LEFT('Precios_ExPLanta_2_TM1'[Productos_ExPlanta], 4) &lt;&gt; "RPMS" &amp;&amp;
                NOT (
                    'Precios_ExPLanta_2_TM1'[Productos_ExPlanta] IN {
                        "Asfalto 150/200", "Asfalto AC-20", "Asfalto MC1", "Asfalto RC2",
                        "Propano Industrial", "Propano Redes", "Supergas", "Supergas A Granel"
                    }
                )
            ),
            "PrecioUSDRaw", CALCULATE(SUM('Precios_ExPLanta_2_TM1'[Valor]), 'Precios_ExPLanta_2_TM1'[Medidas_ExPlanta] = "Precio Ex Planta"),
            "DensidadRaw", CALCULATE(SUM('Precios_ExPLanta_2_TM1'[Valor]), 'Precios_ExPLanta_2_TM1'[Medidas_ExPlanta] = "Densidad"),
            "CotizacionRaw", CALCULATE(SUM('Precios_ExPLanta_2_TM1'[Valor]), 'Precios_ExPLanta_2_TM1'[Medidas_ExPlanta] = "Cotización")
        ),
        "pAnio", VALUE('Precios_ExPLanta_2_TM1'[Años]),
        "MesNumero", SWITCH('Precios_ExPLanta_2_TM1'[Periodo_Mensual], "Ene", 1, "Feb", 2, "Mar", 3, "Abr", 4, "May", 5, "Jun", 6, "Jul", 7, "Ago", 8, "Sep", 9, "Oct", 10, "Nov", 11, "Dic", 12, BLANK()),
        "ProductoNormalizado", IF('Precios_ExPLanta_2_TM1'[Productos_ExPlanta] = "Gasolina Av 100 Octa", "Gasolina Av 100 Octanos", 'Precios_ExPLanta_2_TM1'[Productos_ExPlanta])
    )
VAR __BranchBSeed =
    ADDCOLUMNS(
        __BranchBSeed1,
        "AnioMes", [pAnio] * 100 + [MesNumero],
        "Dia", IF([pAnio] = __CurYear &amp;&amp; [MesNumero] = __CurMonth, FORMAT(__CurDay, "0") &amp; "-" &amp; 'Precios_ExPLanta_2_TM1'[Periodo_Mensual], FORMAT(DAY(EOMONTH(DATE([pAnio], [MesNumero], 1), 0)), "0") &amp; "-" &amp; 'Precios_ExPLanta_2_TM1'[Periodo_Mensual])
    )
VAR __BranchB =
    SELECTCOLUMNS(
        FILTER(__BranchBSeed, IF([ProductoNormalizado] IN { "Queroseno Montevideo", "Queroseno Interior" }, [AnioMes] &lt;= 202107, [AnioMes] &lt;= 202106)),
        "pAnio", [pAnio],
        "MesNumero", [MesNumero],
        "Dia", [Dia],
        "Producto", [ProductoNormalizado],
        "PrecioExPlantaUSD", [PrecioUSDRaw],
        "PrecioExPlantaUYU", IF([ProductoNormalizado] = "Butano Desodorizado", DIVIDE([PrecioUSDRaw] * DIVIDE([CotizacionRaw], [DensidadRaw], BLANK()), 1000), DIVIDE([PrecioUSDRaw] * [CotizacionRaw], 1000)),
        "CotizacionPromedio", [CotizacionRaw]
    )

VAR __PlanillaSeed1 =
    ADDCOLUMNS(
        SUMMARIZECOLUMNS(
            'Precios_Ex_Planta'[Fecha],
            'Precios_Ex_Planta'[Producto],
            'Precios_Ex_Planta'[TC],
            FILTER(
                ALL('Precios_Ex_Planta'),
                'Precios_Ex_Planta'[Concepto] IN { "PPI sin tasas e impuestos + Factor X", "PEP" } &amp;&amp;
                NOT (IF('Precios_Ex_Planta'[Producto] = "GLP", "Supergas", 'Precios_Ex_Planta'[Producto]) = "Supergas" &amp;&amp; 'Precios_Ex_Planta'[Concepto] = "PPI sin tasas e impuestos + Factor X")
            ),
            "PrecioUYURaw", SUM('Precios_Ex_Planta'[Valor])
        ),
        "pAnio", YEAR('Precios_Ex_Planta'[Fecha]),
        "MesNumero", MONTH('Precios_Ex_Planta'[Fecha]),
        "ProductoNormalizado", IF('Precios_Ex_Planta'[Producto] = "GLP", "Supergas", 'Precios_Ex_Planta'[Producto])
    )
VAR __PlanillaSeed2 =
    ADDCOLUMNS(
        __PlanillaSeed1,
        "AnioMes", [pAnio] * 100 + [MesNumero],
        "Dia", IF([pAnio] = __CurYear &amp;&amp; [MesNumero] = __CurMonth, FORMAT(__CurDay, "0") &amp; "-" &amp; SWITCH([MesNumero], 1, "Ene", 2, "Feb", 3, "Mar", 4, "Abr", 5, "May", 6, "Jun", 7, "Jul", 8, "Ago", 9, "Sep", 10, "Oct", 11, "Nov", 12, "Dic"), FORMAT(DAY(EOMONTH('Precios_Ex_Planta'[Fecha], 0)), "0") &amp; "-" &amp; SWITCH([MesNumero], 1, "Ene", 2, "Feb", 3, "Mar", 4, "Abr", 5, "May", 6, "Jun", 7, "Jul", 8, "Ago", 9, "Sep", 10, "Oct", 11, "Nov", 12, "Dic"))
    )
VAR __PlanillaBase =
    SELECTCOLUMNS(
        FILTER(
            __PlanillaSeed2,
            NOT ([ProductoNormalizado] IN { "GasolinaAv100Octanos(Es)", "GasolinaAv100Octanos(Pa)", "Asfalto 150/200", "Asfalto AC-20", "Asfalto MC1", "Asfalto RC2", "Propano Redes" }) &amp;&amp;
            IF([ProductoNormalizado] = "Supergas" || [ProductoNormalizado] = "Propano", [AnioMes] &gt; 202306, IF([ProductoNormalizado] IN { "Queroseno Montevideo", "Queroseno Interior" }, [AnioMes] &gt; 202107, [AnioMes] &gt; 202106))
        ),
        "pAnio", [pAnio],
        "MesNumero", [MesNumero],
        "Producto", [ProductoNormalizado],
        "PrecioUYU", [PrecioUYURaw],
        "TCPlanilla", IF([pAnio] &lt; 2022, 'Precios_Ex_Planta'[TC], BLANK()),
        "Dia", [Dia]
    )

VAR __TM1LookupSeed1 =
    ADDCOLUMNS(
        SUMMARIZECOLUMNS(
            'Precios_ExPLanta_2_TM1'[Años],
            'Precios_ExPLanta_2_TM1'[Periodo_Mensual],
            'Precios_ExPLanta_2_TM1'[Productos_ExPlanta],
            FILTER(
                ALL('Precios_ExPLanta_2_TM1'),
                'Precios_ExPLanta_2_TM1'[Años] &lt;&gt; "Año Base" &amp;&amp;
                'Precios_ExPLanta_2_TM1'[Periodo_Mensual] &lt;&gt; "Base" &amp;&amp;
                LEFT('Precios_ExPLanta_2_TM1'[Productos_ExPlanta], 4) &lt;&gt; "RPMS" &amp;&amp;
                'Precios_ExPLanta_2_TM1'[Mercados] = "Interno" &amp;&amp;
                NOT ('Precios_ExPLanta_2_TM1'[Productos_ExPlanta] IN { "Asfalto 150/200", "Asfalto AC-20", "Asfalto MC1", "Asfalto RC2", "Propano Redes", "Supergas A Granel" })
            ),
            "CotizacionRaw", CALCULATE(SUM('Precios_ExPLanta_2_TM1'[Valor]), 'Precios_ExPLanta_2_TM1'[Medidas_ExPlanta] = "Cotización", 'Precios_ExPLanta_2_TM1'[Unidades] = "N/A"),
            "DensidadRaw", CALCULATE(SUM('Precios_ExPLanta_2_TM1'[Valor]), 'Precios_ExPLanta_2_TM1'[Medidas_ExPlanta] = "Densidad")
        ),
        "pAnio", VALUE('Precios_ExPLanta_2_TM1'[Años]),
        "MesNumero", SWITCH('Precios_ExPLanta_2_TM1'[Periodo_Mensual], "Ene", 1, "Feb", 2, "Mar", 3, "Abr", 4, "May", 5, "Jun", 6, "Jul", 7, "Ago", 8, "Sep", 9, "Oct", 10, "Nov", 11, "Dic", 12, BLANK()),
        "ProductoNormalizado", IF('Precios_ExPLanta_2_TM1'[Productos_ExPlanta] = "Propano Industrial", "Propano", IF('Precios_ExPLanta_2_TM1'[Productos_ExPlanta] = "GLP", "Supergas", IF('Precios_ExPLanta_2_TM1'[Productos_ExPlanta] = "Gasolina Av 100 Octa", "Gasolina Av 100 Octanos", 'Precios_ExPLanta_2_TM1'[Productos_ExPlanta])))
    )
VAR __TM1LookupSeed2 =
    ADDCOLUMNS(
        __TM1LookupSeed1,
        "AnioMes", [pAnio] * 100 + [MesNumero],
        "Dia", IF([pAnio] = __CurYear &amp;&amp; [MesNumero] = __CurMonth, FORMAT(__CurDay, "0") &amp; "-" &amp; 'Precios_ExPLanta_2_TM1'[Periodo_Mensual], FORMAT(DAY(EOMONTH(DATE([pAnio], [MesNumero], 1), 0)), "0") &amp; "-" &amp; 'Precios_ExPLanta_2_TM1'[Periodo_Mensual])
    )
VAR __TM1Lookup =
    SELECTCOLUMNS(
        FILTER(__TM1LookupSeed2, IF([ProductoNormalizado] = "Supergas" || [ProductoNormalizado] = "Propano", [AnioMes] &gt; 202306, IF([ProductoNormalizado] IN { "Queroseno Montevideo", "Queroseno Interior" }, [AnioMes] &gt; 202107, [AnioMes] &gt; 202106))),
        "LookupAnio", [pAnio],
        "LookupMesNumero", [MesNumero],
        "LookupProducto", [ProductoNormalizado],
        "CotizacionTM1", [CotizacionRaw],
        "DensidadTM1", IF([pAnio] = 2021 &amp;&amp; [MesNumero] &lt; 7 || [pAnio] &lt; 2021, BLANK(), [DensidadRaw]),
        "DiaTM1", [Dia]
    )

VAR __DensidadLookupSeed1 =
    ADDCOLUMNS(
        SUMMARIZECOLUMNS(
            'Precios_ExPLanta_2_TM1'[Años],
            'Precios_ExPLanta_2_TM1'[Periodo_Mensual],
            'Precios_ExPLanta_2_TM1'[Productos_ExPlanta],
            FILTER(
                ALL('Precios_ExPLanta_2_TM1'),
                'Precios_ExPLanta_2_TM1'[Años] &lt;&gt; "Año Base" &amp;&amp;
                'Precios_ExPLanta_2_TM1'[Periodo_Mensual] &lt;&gt; "Base" &amp;&amp;
                LEFT('Precios_ExPLanta_2_TM1'[Productos_ExPlanta], 4) &lt;&gt; "RPMS" &amp;&amp;
                'Precios_ExPLanta_2_TM1'[Productos_ExPlanta] &lt;&gt; "N/A" &amp;&amp;
                NOT ('Precios_ExPLanta_2_TM1'[Productos_ExPlanta] IN { "Asfalto 150/200", "Asfalto AC-20", "Asfalto MC1", "Asfalto RC2", "Propano Redes" })
            ),
            "DensidadRaw", CALCULATE(SUM('Precios_ExPLanta_2_TM1'[Valor]), 'Precios_ExPLanta_2_TM1'[Medidas_ExPlanta] = "Densidad")
        ),
        "pAnio", VALUE('Precios_ExPLanta_2_TM1'[Años]),
        "MesNumero", SWITCH('Precios_ExPLanta_2_TM1'[Periodo_Mensual], "Ene", 1, "Feb", 2, "Mar", 3, "Abr", 4, "May", 5, "Jun", 6, "Jul", 7, "Ago", 8, "Sep", 9, "Oct", 10, "Nov", 11, "Dic", 12, BLANK()),
        "ProductoLookup", IF('Precios_ExPLanta_2_TM1'[Productos_ExPlanta] = "Gasolina Av 100 Octa", "Gasolina Av 100 Octanos", 'Precios_ExPLanta_2_TM1'[Productos_ExPlanta])
    )
VAR __DensidadLookupSeed2 =
    ADDCOLUMNS(
        __DensidadLookupSeed1,
        "AnioMes", [pAnio] * 100 + [MesNumero],
        "Dia", IF([pAnio] = __CurYear &amp;&amp; [MesNumero] = __CurMonth, FORMAT(__CurDay, "0") &amp; "-" &amp; 'Precios_ExPLanta_2_TM1'[Periodo_Mensual], FORMAT(DAY(EOMONTH(DATE([pAnio], [MesNumero], 1), 0)), "0") &amp; "-" &amp; 'Precios_ExPLanta_2_TM1'[Periodo_Mensual]),
        "Filtro", IF([pAnio] = 2021 &amp;&amp; [MesNumero] &lt; 7 || [pAnio] &lt; 2021, 0, 1)
    )
VAR __DensidadLookup =
    SELECTCOLUMNS(
        FILTER(__DensidadLookupSeed2, [Filtro] = 1),
        "LookupAnio", [pAnio],
        "LookupMesNumero", [MesNumero],
        "LookupProducto", [ProductoLookup],
        "DensidadTM1", [DensidadRaw]
    )

VAR __BranchCSeed =
    ADDCOLUMNS(
        __PlanillaBase,
        "AnioMes", [pAnio] * 100 + [MesNumero],
        "CotizacionTM1",
            VAR __LookupAnio = [pAnio]
            VAR __LookupMes = [MesNumero]
            VAR __LookupProducto = [Producto]
            RETURN
            MAXX(
                FILTER(
                    __TM1Lookup,
                    [LookupAnio] = __LookupAnio &amp;&amp;
                    [LookupMesNumero] = __LookupMes &amp;&amp;
                    [LookupProducto] = __LookupProducto
                ),
                [CotizacionTM1]
            ),
        "DensidadTM1",
            VAR __LookupAnio = [pAnio]
            VAR __LookupMes = [MesNumero]
            VAR __LookupProducto = IF([Producto] = "Propano", "Propano Industrial", [Producto])
            RETURN
            MAXX(
                FILTER(
                    __DensidadLookup,
                    [LookupAnio] = __LookupAnio &amp;&amp;
                    [LookupMesNumero] = __LookupMes &amp;&amp;
                    [LookupProducto] = __LookupProducto
                ),
                [DensidadTM1]
            ),
        "ProductoFinal", IF([Producto] = "Propano", "Propano Industrial", [Producto])
    )
VAR __BranchCBase =
    ADDCOLUMNS(
        __BranchCSeed,
        "CotizacionUsada", IF([pAnio] &lt; 2022, [TCPlanilla], [CotizacionTM1]),
        "PrecioUSDsinDensidad", DIVIDE([PrecioUYU], IF([pAnio] &lt; 2022, [TCPlanilla], [CotizacionTM1]), BLANK()) * 1000,
        "PrecioUSD", IF([Producto] IN { "Butano Desodorizado", "Supergas", "Propano", "Propano Industrial" }, DIVIDE([PrecioUYU], IF([pAnio] &lt; 2022, [TCPlanilla], [CotizacionTM1]), BLANK()) * 1000 * [DensidadTM1], DIVIDE([PrecioUYU], IF([pAnio] &lt; 2022, [TCPlanilla], [CotizacionTM1]), BLANK()) * 1000)
    )
VAR __BranchCRegular =
    SELECTCOLUMNS(
        __BranchCBase,
        "pAnio", [pAnio],
        "MesNumero", [MesNumero],
        "Dia", [Dia],
        "Producto", [ProductoFinal],
        "PrecioExPlantaUSD", [PrecioUSD],
        "PrecioExPlantaUYU", [PrecioUYU],
        "CotizacionPromedio", [CotizacionUsada]
    )
VAR __BranchCSupergasGranel =
    SELECTCOLUMNS(
        FILTER(__BranchCBase, [Producto] = "Propano" &amp;&amp; [AnioMes] &lt;= 202312),
        "pAnio", [pAnio],
        "MesNumero", [MesNumero],
        "Dia", [Dia],
        "Producto", "Supergas A Granel",
        "PrecioExPlantaUSD", [PrecioUSDsinDensidad] * [DensidadTM1],
        "PrecioExPlantaUYU", [PrecioUYU],
        "CotizacionPromedio", [CotizacionUsada]
    )

VAR __FinalRows =
    ADDCOLUMNS(
        UNION(__BranchA, __BranchB, __BranchCRegular, __BranchCSupergasGranel),
        "Orden", SWITCH([Producto], "Super 95 Sp", 1, "Premium 97 Sp", 2, "Queroseno Montevideo", 3, "Queroseno Interior", 4, "Gasoil Comun", 5, "Gasoil Especial", 6, "Gasolina Av 100 Octanos", 7, "Jet A1", 8, "Supergas", 9, "Supergas A Granel", 10, "Butano Desodorizado", 11, "Propano Industrial", 12, "Propano Redes", 13, "Fuel Oil Pesado", 14, "Fuel Oil Medio", 15, "Solvente 1197", 16, "Disan", 17, "Base insecticida", 18, "Aguarras", 19, "Querosol", 20, "Hexano Comercial", 21, "Asfalto AC-20", 22, "Asfalto 150/200", 23, "Asfalto MC1", 24, "Asfalto RC2", 25, 999),
        "Unidad", SWITCH([Producto], "Supergas", "$/kg", "Supergas A Granel", "$/kg", "Propano Industrial", "$/kg", "Propano Redes", "$/kg", "Asfalto AC-20", "$/kg", "Asfalto 150/200", "$/kg", "Asfalto MC1", "$/kg", "Asfalto RC2", "$/kg", "Butano Desodorizado", "$/kg", "$/lt")
    )
RETURN
SELECTCOLUMNS(__FinalRows, "pAnio", [pAnio], "MesNumero", [MesNumero], "Dia", [Dia], "Producto", [Producto], "Orden", [Orden], "Unidad", [Unidad], "PrecioExPlantaUSD", [PrecioExPlantaUSD], "PrecioExPlantaUYU", [PrecioExPlantaUYU], "CotizacionPromedio", [CotizacionPromedio])
ORDER BY [Orden], [Producto], [MesNumero]
        </CommandText>
      </Query>
      <Fields>
        <Field Name="pAnio">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>[pAnio]</DataField>
        </Field>
        <Field Name="MesNumero">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>[MesNumero]</DataField>
        </Field>
        <Field Name="Dia">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Dia]</DataField>
        </Field>
        <Field Name="Producto">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Producto]</DataField>
        </Field>
        <Field Name="Orden">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>[Orden]</DataField>
        </Field>
        <Field Name="Unidad">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>[Unidad]</DataField>
        </Field>
        <Field Name="PrecioExPlantaUSD">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>[PrecioExPlantaUSD]</DataField>
        </Field>
        <Field Name="PrecioExPlantaUYU">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>[PrecioExPlantaUYU]</DataField>
        </Field>
        <Field Name="CotizacionPromedio">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>[CotizacionPromedio]</DataField>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!pAnio.Value</FilterExpression>
          <Operator>Equal</Operator>
          <FilterValues>
            <FilterValue>=Parameters!pAnio.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
  </DataSets>
